# whatsappel bridge environment — copy to .env, fill in, source it.
# Do NOT commit .env (it holds secrets).
#   set -a; . ./.env; set +a
#   guile whatsappel.scm

# --- bridge (Emacs-facing) ---
# Generate with: openssl rand -hex 32
export WHATSAPPEL_TOKEN="CHANGE-ME-long-random-hex"
export WHATSAPPEL_HOST="127.0.0.1"
export WHATSAPPEL_PORT="7337"
export WHATSAPPEL_PUBLIC_URL="http://127.0.0.1:7337"
export WHATSAPPEL_SUBSCRIBE="Message"
# Per-chat history depth pulled from wuzapi on startup (and POST /sync).
export WHATSAPPEL_HISTORY="200"
# Optional: wuzapi's whatsmeow store (main.db), read read-only to resolve chats
# addressed by WhatsApp's anonymous @lid id to a phone number / contact name.
# Leave empty to disable. Typical path under a -datadir run shown below.
export WHATSAPPEL_LIDMAP_DB=""

# --- wuzapi (WhatsApp engine) ---
export WUZAPI_BASE_URL="http://127.0.0.1:8080"
export WUZAPI_TOKEN="your-wuzapi-user-token"
# "Token" for most builds; some builds expect "Authorization".
export WUZAPI_TOKEN_HEADER="Token"
