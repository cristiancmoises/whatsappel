(ert-deftest wa-rc13-lid-target-is-not-a-phone ()
  (should (equal (whatsapp--target-of-jid "123456789012345@lid") "123456789012345@lid")))
(ert-deftest wa-rc13-phone-and-group-targets-remain-compatible ()
  (dolist (pair '(("551100000001@s.whatsapp.net" . "551100000001")
                  ("551100000001@c.us" . "551100000001")
                  ("551100000001" . "551100000001")
                  ("120000000000@g.us" . "120000000000@g.us")
                  ("opaque@example.test" . "opaque@example.test")))
    (should (equal (whatsapp--target-of-jid (car pair)) (cdr pair)))))
(ert-deftest wa-rc13-empty-target-is-rejected ()
  (should-error (whatsapp--target-of-jid "") :type 'user-error)
  (should-error (whatsapp--target-of-jid nil) :type 'user-error))
(ert-deftest wa-rc13-send-recomputes-stale-lid-target ()
  (wa-rc2-chat
   (setq whatsapp-chat--jid "123456789012345@lid" whatsapp-chat--target "123456789012345")
   (whatsapp-chat--render nil) (insert "local fixture")
   (let (payload callback (calls 0))
     (cl-letf (((symbol-function 'whatsapp--request-async)
                (lambda (_method _path body cb) (cl-incf calls) (setq payload body callback cb))))
       (whatsapp-chat-send-input)
       (should (= calls 1))
       (should (equal (cdr (assoc "to" payload)) "123456789012345@lid"))
       (should (equal (whatsapp-chat--current-input) "local fixture"))
       (should (eq (plist-get (car whatsapp-chat--outgoing) :state) 'sending))
       (should-error (whatsapp-chat-send-input) :type 'user-error)
       (should (= calls 1))
       (funcall callback '(503 ("uncertain" . t)))
       (should (eq (plist-get (car whatsapp-chat--outgoing) :state) 'unconfirmed))
       (should (equal (whatsapp-chat--current-input) "local fixture"))))))
(ert-deftest wa-rc13-accepted-note-survives-stale-history ()
  (wa-rc2-chat
   (whatsapp-chat--render nil) (insert "own fixture")
   (let (callback)
     (cl-letf (((symbol-function 'whatsapp--request-async) (lambda (_m _p _d cb) (setq callback cb)))
               ((symbol-function 'whatsapp-chat-refresh) #'ignore))
       (whatsapp-chat-send-input) (funcall callback (wa-delivery-ack)))
     (should (equal (whatsapp-chat--current-input) ""))
     (should (eq (plist-get (car whatsapp-chat--outgoing) :state) 'accepted))
     (should (string-match-p "awaiting history/receipt"
                             (overlay-get whatsapp-chat--outgoing-overlay 'before-string)))
     (whatsapp-chat--render nil)
     (whatsapp-chat--reconcile-outgoing nil)
     (should (= (length whatsapp-chat--outgoing) 1))
     (should (overlayp whatsapp-chat--outgoing-overlay)))))
(ert-deftest wa-rc13-accepted-note-deduplicates-by-provider-id-not-text ()
  (wa-rc2-chat
   (whatsapp-chat--render nil)
   (let ((entry (whatsapp-chat--begin-outgoing "fixture" (whatsapp--origin-key) "fixture")))
     (whatsapp-chat--finish-outgoing entry (wa-delivery-ack))
     (whatsapp-chat--reconcile-outgoing '((("id" . "other") ("me" . t) ("text" . "fixture"))))
     (should (= (length whatsapp-chat--outgoing) 1))
     (whatsapp-chat--reconcile-outgoing '((("id" . "fixture-id") ("me" . nil))))
     (should (= (length whatsapp-chat--outgoing) 1))
     (whatsapp-chat--reconcile-outgoing '((("id" . "fixture-id") ("me" . t) ("delivery" . "accepted"))))
     (should-not whatsapp-chat--outgoing)
     (should-not whatsapp-chat--outgoing-overlay))))
(ert-deftest wa-rc13-note-keeps-draft-and-undo-positions ()
  (wa-rc2-chat
   (whatsapp-chat--render nil) (buffer-enable-undo) (insert "keep draft")
   (let ((before (buffer-string)) (position (point)) (marker (marker-position whatsapp-chat--input-marker))
         (undo buffer-undo-list) (modified (buffer-modified-p)))
     (whatsapp-chat--begin-outgoing "fixture" (whatsapp--origin-key) "fixture")
     (should (equal before (buffer-string))) (should (= position (point)))
     (should (= marker (marker-position whatsapp-chat--input-marker)))
     (should (eq undo buffer-undo-list)) (should (eq modified (buffer-modified-p))))))
(ert-deftest wa-rc13-note-reuses-one-overlay ()
  (wa-rc2-chat
   (whatsapp-chat--render nil)
   (whatsapp-chat--begin-outgoing "fixture" (whatsapp--origin-key) "fixture")
   (let ((overlay whatsapp-chat--outgoing-overlay) (chars (buffer-chars-modified-tick)))
     (dotimes (_ 200) (whatsapp-chat--paint-outgoing))
     (should (eq overlay whatsapp-chat--outgoing-overlay))
     (should (= chars (buffer-chars-modified-tick)))
     (should (= 1 (cl-count-if (lambda (o) (overlay-get o 'whatsapp-outgoing-note))
                               (append (car (overlay-lists)) (cdr (overlay-lists)))))))))
