# systemd user unit for the whatsappel bridge.
# Install: cp whatsappel.service ~/.config/systemd/user/
#          systemctl --user daemon-reload && systemctl --user enable --now whatsappel
# Requires an EnvironmentFile with WHATSAPPEL_TOKEN and WUZAPI_TOKEN.
[Unit]
Description=whatsappel bridge (Emacs <-> wuzapi)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/whatsappel
EnvironmentFile=%h/whatsappel/.env
ExecStart=/usr/bin/guile %h/whatsappel/whatsappel.scm
Restart=on-failure
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/whatsappel
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictNamespaces=true

[Install]
WantedBy=default.target
