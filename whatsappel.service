# systemd user unit for the whatsappel bridge.
# Install: cp whatsappel.service ~/.config/systemd/user/
#          systemctl --user daemon-reload && systemctl --user enable --now whatsappel
# Loads the existing shell-style .env with a restrictive process umask.
[Unit]
Description=whatsappel bridge (Emacs <-> wuzapi)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/whatsappel
ExecStart=/usr/bin/env bash -c 'set -e; set -a; . "$$HOME/whatsappel/.env"; set +a; exec guile "$$HOME/whatsappel/whatsappel.scm"'
UMask=0077
Restart=on-failure
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/whatsappel
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictNamespaces=true

[Install]
WantedBy=default.target
